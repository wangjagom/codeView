# Supabase 대시보드 → Project Settings → API (Data API) 에서 복사해요.
# anon(public) 키는 브라우저에 노출되는 공개 키예요. service_role 키는 절대 넣지 마세요.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# 화면에 보일 팀 이름과 과제 목록(쉼표로 구분)
VITE_TEAM_NAME=3조 코드방
VITE_TASKS=4주차 · Todo 앱,3주차 · 쇼핑몰,2주차 · 로그인,자유 질문
